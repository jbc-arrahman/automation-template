# ============================================================================
# browser-use Boilerplate — Environment Configuration
# Copy this file to `.env`:   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. LLM PROVIDER & API KEY
# ----------------------------------------------------------------------------
# Provider: google | openai | anthropic | azure | groq | openrouter | deepseek | mistral | ollama | openai_compatible | aws
# Recommendation: `google` (Gemini) is the most cost-effective provider for vision-enabled browser work.
LLM_PROVIDER=google

# Leave LLM_MODEL empty to use the provider's recommended default (e.g., gemini-3.6-flash for google).
LLM_MODEL=

# Either set LLM_API_KEY here, or set the provider-specific key below:
LLM_API_KEY=
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# Optional custom endpoint (required for openai_compatible, optional for ollama/others):
# LLM_BASE_URL=http://localhost:11434
# LLM_TEMPERATURE=

# Send page screenshots to the LLM on every step (recommended with Gemini Flash):
USE_VISION=true

# ----------------------------------------------------------------------------
# 2. BROWSER MODE
# ----------------------------------------------------------------------------
# Mode:
#   installed -> Mode 1: Use the device's installed Google Chrome over CDP (keeps logins/cookies).
#   fresh     -> Mode 2: Launch a completely new browser instance managed by browser-use.
BROWSER_MODE=fresh

# --- Mode 1: Installed Browser (BROWSER_MODE=installed) ---
# Action:
#   launch -> Start installed Chrome on CHROME_USER_DATA_DIR with --remote-debugging-port if not already running.
#   attach -> Connect to an already-running Chrome on CDP_HOST:CDP_PORT (or CDP_URL).
INSTALLED_ACTION=launch
# Leave empty to auto-detect Chrome on macOS, Linux, or Windows:
CHROME_BINARY=
# Dedicated profile folder for remote debugging (Chrome 136+ blocks CDP on the default OS profile dir):
CHROME_USER_DATA_DIR=./profiles/installed
CHROME_PROFILE_DIRECTORY=Default
CDP_HOST=127.0.0.1
CDP_PORT=9222
# Full URL override (e.g., http://host.docker.internal:9222 when attaching from Docker):
CDP_URL=
# Keep installed Chrome open after a run finishes (default false = stays open):
CLOSE_INSTALLED_ON_EXIT=false

# --- Mode 2: Fresh Instance (BROWSER_MODE=fresh) ---
HEADLESS=false
# Profile lifecycle for fresh mode:
#   ephemeral  -> Brand-new temp folder per run, deleted when the run ends.
#   persistent -> Saved under PROFILES_DIR/fresh/<FRESH_PROFILE_NAME> so cookies survive across runs.
FRESH_PROFILE=ephemeral
FRESH_PROFILE_NAME=default
PROFILES_DIR=./profiles
# Optional path to a specific Chromium/Chrome binary for Mode 2 (empty = Playwright's Chromium or auto-detected):
FRESH_EXECUTABLE_PATH=

# --- Shared Browser Settings ---
WINDOW_WIDTH=1366
WINDOW_HEIGHT=900
# Comma-separated domain allowlist (empty = use each task's `allowed_domains` or allow all):
ALLOWED_DOMAINS=
WAIT_BETWEEN_ACTIONS=0.5
# Comma-separated extra Chromium flags (e.g. --lang=en-US,--mute-audio):
EXTRA_CHROME_ARGS=

# ----------------------------------------------------------------------------
# 3. AGENT LIMITS, COST & LOGGING
# ----------------------------------------------------------------------------
AGENT_MAX_STEPS=25
AGENT_TASK_TIMEOUT_SEC=360
AGENT_MAX_FAILURES=3

# Daily spend cap in USD (0 = unlimited):
MAX_DAILY_LLM_COST=0.00

LOGS_DIR=./logs
TRACE_ENABLED=true
LOG_LEVEL=INFO
